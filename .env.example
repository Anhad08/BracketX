# Copy to .env and fill in. Never commit .env.
# Every variable consumed at build time must also be declared in turbo.json
# under tasks.build.env, or Turborepo will serve a cache artifact built
# against different values.

# --- Database (Postgres) ---
# Local:  docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:17
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bracketx"

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
