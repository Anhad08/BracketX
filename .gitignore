# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Local Postgres data dir (packages/db/scripts/dev-postgres.mjs)
.pgdata/
.pgdata-*/

# Screenshot evidence for a sprint review. Regenerated by `gallery.spec.ts`,
# never a source of truth, and large.
apps/studio/shots/
apps/studio/shots-before/

# Playwright output. Generated on every run, and it had been COMMITTED —
# `test-results/.last-run.json` and an `error-context.md` from one failed audit
# were tracked, so a passing run showed up as a dirty tree and a failing one
# rewrote history nobody had authored.
test-results/
playwright-report/

# Debug screenshots dropped at an app root by a pixel-probe run (`p3d.png`,
# `p-count.png`). No legitimate image lives directly at `apps/studio/` — the real
# ones are in `public/images/`, `shots/` and `walkthrough/` — so anything here is
# scratch. Fenced off rather than deleted: a session may still be reading it.
apps/studio/*.png

# Design-review renders. Generated by e2e/design-review.spec.ts for looking at,
# never a source of truth — and a stray graphic PNG in the repo gets reviewed as
# though it were shipped content.
apps/studio/design/
