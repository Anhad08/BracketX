{
  "name": "studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bracketx/engine-host": "workspace:*",
    "@bracketx/engine-reconciler": "workspace:*",
    "@bracketx/engine-render-three": "workspace:*",
    "@bracketx/engine-scene": "workspace:*",
    "@bracketx/engine-runtime": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@bracketx/engine-assets": "workspace:*",
    "@bracketx/engine-image": "workspace:*"
  },
  "devDependencies": {
    "@bracketx/eslint-config": "workspace:*",
    "@bracketx/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.62.1",
    "three": "^0.185.1",
    "@types/three": "^0.185.3"
  }
}
